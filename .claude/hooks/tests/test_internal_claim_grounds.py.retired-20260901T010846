def test_a1_a_record_written_before_a1_still_loads_and_says_it_does_not_know():
    """A pre-A1 record has neither key. It must load, and must NOT read as unscoped.

    "Nobody recorded a bound" and "the person declared no bound" are different
    facts; collapsing them would let a legacy record answer a question it was
    never asked.
    """
    entry = arec.EvidenceEntry.from_dict({
        "run_id": "old-run",
        "pin_str": "code:myrepo@abc123:pkg/mod.py:1-2",
        "evidence_path": arec.EVIDENCE_CAPTURED,
        "excerpt": "one\ntwo\n",
        "at": "2026-01-01T00:00:00+00:00",
    })
    assert entry.declaration_bound is None
    assert entry.matched_selector is None
    assert entry.declaration_bound != srec.SCOPE_MODE_UNSCOPED


