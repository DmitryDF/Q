def test_a1_an_enumerated_declaration_is_recorded_with_the_selector_that_matched(
        port, store, tmp_path):
    lib = tmp_path / "lib"
    (lib / "pkg").mkdir(parents=True)
    target = lib / "pkg" / "mod.py"
    target.write_text("one\ntwo\n", encoding="utf-8")
    item = _item(target)
    result = port.admit(item, srec.code_scope([lib]), _adapter(item, _read()),
                        "run-1")

    assert result.admitted
    assert result.declaration_bound == srec.SCOPE_MODE_ENUMERATED
    assert result.matched_selector == str(lib.resolve())


def test_a1_an_unscoped_declaration_is_recorded_as_unscoped_with_no_selector(
        port, store):
    item = _item()
    result = port.admit(item, _unscoped_code_scope(), _adapter(item, _read()),
                        "run-1")

    assert result.admitted
    assert result.declaration_bound == srec.SCOPE_MODE_UNSCOPED
    # No selector was consulted, so naming one would be an invention.
    assert result.matched_selector is None


def test_a1_the_evidence_entry_round_trips_the_bound_through_the_store(
        port, store, tmp_path):
    lib = tmp_path / "lib"
