    assert [c.line for c in found] == [1, 2]


def test_a2_the_locator_the_shipped_parser_discards_arrives_intact():
    """The third ground: fineness rides the pin's tail, which `_claim_harvest`
    drops. Two citations differing ONLY in that tail must stay distinguishable."""
    import _claim_harvest as harvest

    whole = "code:r@1:pkg/mod.py:1-400"
    narrow = "code:r@1:pkg/mod.py:12-14"
    text = f"A. [stated — {whole}]\nB. [stated — {narrow}]"

    # What the shipped parser keeps: it SEES both citations and keeps no payload
    # for either. The count is asserted first — `all()` over an empty list is
    # true, which would pass this for the opposite reason.
    shipped = harvest.extract_marked_claims(text)["stated"]
    assert len(shipped) == 2
    assert all(c["url"] is None for c in shipped)
    # What A2 keeps.
    assert [c.pin_str for c in icg.extract_internal_citations(text)] == [whole,
                                                                        narrow]


# =========================================================================== #
# A2 — the coupling: the marker payload IS the store's key
# =========================================================================== #

def _admit_one(port, tmp_path):
    lib = tmp_path / "lib"
    (lib / "pkg").mkdir(parents=True)
    target = lib / "pkg" / "mod.py"
    target.write_text("one\ntwo\n", encoding="utf-8")
    item = _item(target)
    return port.admit(item, srec.code_scope([lib]), _adapter(item, _read()),
                      "run-1")


def test_a2_the_marker_payload_equals_the_key_admit_wrote(port, store, tmp_path):
    """The coupling, pinned so a divergence is a red test rather than silence.

    Neither half is derived from the other: the KEY comes from driving `admit()`
    (which is what exercises the port), and the PAYLOAD comes from A2's own
    extraction over the marker `SourcePin.marker()` renders. Deriving the key
    from `pin.render()` would leave the port untested; re-deriving the payload
    from a format string would make the assertion a tautology.
    """
    result = _admit_one(port, tmp_path)
    key = result.pin_str

    found = icg.extract_internal_citations(
        f'The module opens with "one". {result.pin.marker("stated")}')

    assert len(found) == 1
    assert found[0].pin_str == key
    assert store.get_evidence(found[0].pin_str) is not None


def test_a2_the_coupling_assertion_fails_when_marker_and_pin_str_diverge(
        port, store, tmp_path, monkeypatch):
    """Proves the assertion above is load-bearing rather than trivially true.

    With `marker()` no longer wrapping `render()`, the extracted payload stops
    matching the key — and the lookup comes back empty rather than resolving to
    the wrong entry.
    """
    result = _admit_one(port, tmp_path)
    key = result.pin_str

    def _diverged(self, kind="stated"):
        # Drops the locator tail — the shape a careless marker change produces.
        return f"[{kind} — {self.locator.kind}:{self.source_id}@{self.version}]"

    monkeypatch.setattr(sp.SourcePin, "marker", _diverged)
    found = icg.extract_internal_citations(
        f'A claim. {result.pin.marker("stated")}')

    assert len(found) == 1
    assert found[0].pin_str != key
    assert store.get_evidence(found[0].pin_str) is None


# =========================================================================== #
# A2 — resolution: fail-soft, never a false confirmation
# =========================================================================== #

def test_a2_a_declared_read_resolves_all_three_grounds(port, store, tmp_path):
    result = _admit_one(port, tmp_path)
    text = f'The module opens with "one". {result.pin.marker("stated")}'

    grounds = icg.read_internal_grounds(text, store)

    assert len(grounds) == 1
    g = grounds[0]
    assert g.status == icg.GROUNDS_RESOLVED
    assert g.declaration_bound == srec.SCOPE_MODE_ENUMERATED   # ground 1
    assert g.evidence_path in arec.EVIDENCE_PATHS              # ground 2
    assert g.citation.pin_str == result.pin_str                # ground 3 rides here
    assert g.reason is None


def test_a2_an_unmatched_citation_is_ungraded_not_confirmed_and_does_not_crash(
        store):
    text = "A claim nobody read. [stated — code:ghost@000:no/such.py:1-1]"

    grounds = icg.read_internal_grounds(text, store)

    assert len(grounds) == 1
    assert grounds[0].status == icg.GROUNDS_UNGRADED
    assert not grounds[0].resolved
    assert grounds[0].declaration_bound is None
    assert grounds[0].evidence_path is None
    assert "no admission record" in grounds[0].reason


def test_a2_an_unreadable_store_yields_ungraded_rather_than_raising():
    """Detection sits on top of containment: a fact-check must not fail because
    an admission record could not be read."""

    class _Broken:
        def get_evidence(self, pin_str, run_id=None):
            raise OSError("record file is unreadable")

    grounds = icg.read_internal_grounds(
        "A. [stated — code:r@1:a.py:1-1]", _Broken())

    assert grounds[0].status == icg.GROUNDS_UNGRADED
    assert "could not be read" in grounds[0].reason


def test_a2_a_pure_web_report_touches_the_store_not_at_all():
    class _Tripwire:
        def get_evidence(self, pin_str, run_id=None):    # pragma: no cover
            raise AssertionError("a web-only report must not query the record")

    text = "A. [stated — https://example.com/a]\nB. [My assessment: fine]"
    assert icg.read_internal_grounds(text, _Tripwire()) == ()


def test_a2_resolution_is_by_pin_and_finds_an_entry_from_any_run(port, store,
                                                                 tmp_path):
    """A later reader holds the citation, not the run identity.

    The entry is written under `run-1`; the resolution names no run and must
    still find it — which is what "resolve BY PIN, not run id" buys.
    """
    result = _admit_one(port, tmp_path)
    # A second, unrelated run in the same store.
    store.put_evidence(arec.EvidenceEntry(
        run_id="run-2", pin_str="code:other@1:z.py:1-1",
        evidence_path=arec.EVIDENCE_CAPTURED, excerpt="z"))

    grounds = icg.read_internal_grounds(
        f'A. {result.pin.marker("stated")}', store)

    assert grounds[0].status == icg.GROUNDS_RESOLVED


def test_a2_a_pre_a1_entry_resolves_but_reports_an_unknown_bound(store):
    """The two absences stay distinguishable end to end: the citation RESOLVES
    (an entry exists) while its bound reports nothing (nobody recorded one)."""
    store.put_evidence(arec.EvidenceEntry(
        run_id="old", pin_str="code:r@1:a.py:1-1",
        evidence_path=arec.EVIDENCE_CAPTURED, excerpt="a"))

    grounds = icg.read_internal_grounds("A. [stated — code:r@1:a.py:1-1]", store)

    assert grounds[0].status == icg.GROUNDS_RESOLVED
    assert grounds[0].declaration_bound is None


def test_a2_summarize_counts_both_outcomes(port, store, tmp_path):
    result = _admit_one(port, tmp_path)
    text = "\n".join([
        f'A. {result.pin.marker("stated")}',
        "B. [stated — code:ghost@000:no/such.py:1-1]",
    ])

    counts = icg.summarize(icg.read_internal_grounds(text, store))

    assert counts == {"internal_citations": 2,
                      icg.GROUNDS_RESOLVED: 1,
                      icg.GROUNDS_UNGRADED: 1}


def test_a2_get_evidence_now_has_a_production_caller():
    """A2's headline, asserted rather than asserted-in-prose.

    The accessor shipped at S3 and sat with zero production callers for four
    slices. A scan over production modules — tests excluded, since a test caller
    is exactly what it already had — must find at least one, and it must not be
    the module that defines it.
    """
    definer = (RESEARCH_DIR / "admission_record.py").resolve()
    callers = []
    for root in (HOOKS_DIR, SKILLS_DIR):
        for path in root.rglob("*.py"):
            parts = set(path.parts)
            if "tests" in parts or "__pycache__" in parts:
                continue
            if path.resolve() == definer:
                continue
            try:
                text = path.read_text(encoding="utf-8")
            except OSError:                              # pragma: no cover
                continue
            if ".get_evidence(" in text:
                callers.append(path.name)

    assert callers, ("get_evidence still has no production caller; A2 is what "
                     "gives it one")
    assert "internal_claim_grounds.py" in callers
