def test_a1_the_port_carries_the_bound_and_never_branches_on_it():
    """A8, structurally: the rule that judges the grounds may not live in the port.

    An AST scan of every branch condition in `source_port.py`. A field that is
    only ever WRITTEN cannot change what admit/refuse decides — which is what
    "admit/refuse byte-identical" means at the code level, and is checkable
    without the pre-A1 file to diff against.
    """
    tree = ast.parse((RESEARCH_DIR / "source_port.py").read_text(encoding="utf-8"))
    guarded = {"declaration_bound", "matched_selector"}
    offenders = []
    for node in ast.walk(tree):
        tests = []
        if isinstance(node, (ast.If, ast.While, ast.IfExp)):
            tests = [node.test]
        elif isinstance(node, ast.comprehension):
            tests = list(node.ifs)
        elif isinstance(node, ast.Assert):
            tests = [node.test]
        for test in tests:
            for sub in ast.walk(test):
                name = None
                if isinstance(sub, ast.Attribute):
                    name = sub.attr
                elif isinstance(sub, ast.Name):
                    name = sub.id
                if name in guarded:
                    offenders.append((name, getattr(node, "lineno", "?")))
    assert not offenders, (
        f"source_port.py branches on a recorded ground: {offenders}. The port "
        "records the grounds; the grader judges them (design-A8).")


def test_a1_the_same_read_under_two_declarations_differs_only_in_the_bound(
        tmp_path):
    """The behavioural half of "byte-identical": the decision, the pin, the
    evidence path and the content are untouched by which declaration admitted it."""
    lib = tmp_path / "lib"
    (lib / "pkg").mkdir(parents=True)
    target = lib / "pkg" / "mod.py"
    target.write_text("one\ntwo\n", encoding="utf-8")

    def _run(scope):
        item = _item(target)
        return sp.AdmissionPort(arec.InMemoryAdmissionRecordStore()).admit(
            item, scope, _adapter(item, _read()), "run-1")

    enumerated = _run(srec.code_scope([lib]))
    unscoped = _run(_unscoped_code_scope())

    assert enumerated.admitted and unscoped.admitted
    assert enumerated.pin_str == unscoped.pin_str
    assert enumerated.evidence_path == unscoped.evidence_path
    assert enumerated.content == unscoped.content
    assert enumerated.truncated == unscoped.truncated
    assert enumerated.declaration_bound != unscoped.declaration_bound


def test_a1_the_recorded_bound_is_the_one_that_admitted_it_not_the_first_declared(
        tmp_path):
    """Two declarations of the same kind; the SECOND one contains the target.

    The bound is read off the very check result the admit branch decided on, so
    it cannot drift to a declaration that refused this item.
    """
    a = tmp_path / "a"
    b = tmp_path / "b"
    (a / "pkg").mkdir(parents=True)
    (b / "pkg").mkdir(parents=True)
    target = b / "pkg" / "mod.py"
    target.write_text("one\ntwo\n", encoding="utf-8")
    scope = srec.ScopeRecord(sources=(
        srec.DeclaredSource(kind=srec.KIND_CODE,
                            scope_mode=srec.SCOPE_MODE_ENUMERATED,
                            selectors=(str(a),)),
        srec.DeclaredSource(kind=srec.KIND_CODE,
                            scope_mode=srec.SCOPE_MODE_ENUMERATED,
                            selectors=(str(b),)),))
    item = _item(target)
    result = sp.AdmissionPort(arec.InMemoryAdmissionRecordStore()).admit(
        item, scope, _adapter(item, _read()), "run-1")

    assert result.matched_selector == str(b.resolve())


