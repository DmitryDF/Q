# --------------------------------------------------------------------------- #
# Fixtures — the gate's own prescription: the real port over the side-effect-free
# store, driven by the deterministic adapter. No disk, no clock, no network.
# --------------------------------------------------------------------------- #

@pytest.fixture()
def store():
    return arec.InMemoryAdmissionRecordStore()


@pytest.fixture()
def port(store):
    return sp.AdmissionPort(store)


def _item(target="/lib/pkg/mod.py"):
    return sp.SourceItem(item_id=str(target), kind=srec.KIND_CODE,
                         target=str(target), depth=0)


def _read(content="one\ntwo\n", *, dirty=False, path="pkg/mod.py",
          lines="1-2", source_id="myrepo", version="abc123"):
    return sp.ReadResult(source_id=source_id, version=version,
                         locator=lg.code_locator(path, lines),
                         content=content, dirty=dirty)


def _adapter(item, read, *, can_reopen=True):
    return sp.FakeAdapter(items=(item,), reads={item.item_id: read},
                          can_reopen_without_credentials=can_reopen)


def _unscoped_code_scope():
    """An unscoped `code` declaration.

    Hand-built because `code_scope()` cannot express one — every convenience
    constructor for a path-shaped kind is enumerated by design. The mode is what
    is under test, so it has to be stated rather than borrowed.
    """
    return srec.ScopeRecord(sources=(
        srec.DeclaredSource(kind=srec.KIND_CODE,
                            scope_mode=srec.SCOPE_MODE_UNSCOPED),))


