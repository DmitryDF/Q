def test_a2_the_internal_locators_are_derived_from_the_citation_registry():
    import _factcheck_engine as engine

    expected = {m.locator for m in engine.CITATION_MARKER_REGISTRY
                if m.source_class == "internal" and m.locator}
    assert set(icg.internal_locators()) == expected
    # The shipped internal vocabulary, named so a silent shrink is visible here.
    assert {"code", "linear", "local-file"} <= set(icg.internal_locators())
    # Web is not internal and must not be swept in.
    assert "url" not in icg.internal_locators()


