# ---------------------------------------------------------------------------
class _E2EBase(unittest.TestCase):
    """Fixture + helpers shared by the two end-to-end classes.

    A base rather than a subclass relationship, so the second class does not
    silently re-run the first's four tests under a different name.
    """

    PROJ = "TestS10"
    TOPIC = "grading"
    SID = "test-s10-a5"

    def setUp(self):
        self.tmp = Path(tempfile.mkdtemp())
        self.state_dir = self.tmp / "validation"
        self.resolver = _mock_resolver(self.PROJ, self.TOPIC)
        self.rp_dir = self.tmp / "rp"
        self.rp_dir.mkdir()
        self._prev_rp = os.environ.get("RP_STATE_DIR")
        os.environ["RP_STATE_DIR"] = str(self.rp_dir)
        self.report = self.tmp / "demo-20260101010101_RESEARCH.md"

    def tearDown(self):
        if self._prev_rp is None:
            os.environ.pop("RP_STATE_DIR", None)
        else:
            os.environ["RP_STATE_DIR"] = self._prev_rp
        shutil.rmtree(self.tmp, ignore_errors=True)

    def _topic_dir(self):
        return self.state_dir / self.PROJ / self.TOPIC / "research"

    def _run(self, seed=()):
        """Drive a real `factcheck_run`, seeding the run's OWN admission store.

        The seeding wraps `_resolve_web_admission` rather than pre-writing a
        record file, and the reason is worth stating: that resolver stamps the
        store with `datetime.now()`, and `get_evidence` searches by the store's
        own `<slug>-<ts>_ADMISSION_*` stem. A record written by a test-built
        store with a fixed timestamp therefore sits under a DIFFERENT stem and
        is invisible to the run — which is what the first version of these tests
        did, and it read as "the gate found no floor hit" rather than as a
        broken fixture. In production both halves are the same store object, so
        the mismatch is an artefact of seeding, not of the code under test.

        Everything else is the real thing: the real resolver, the real store,
        the real gate chain, the real marker sequence. Only the CONTENT checker
        is injected, exactly as every sibling FC test does.
        """
        real = eng._resolve_web_admission

        def _seeding_resolver(*args, **kwargs):
            scope, store = real(*args, **kwargs)
            for pin, bound, evidence in seed:
                entry = {"run_id": "seed", "pin_str": pin,
                         "evidence_path": evidence, "declaration_bound": bound}
                if evidence == arec.EVIDENCE_ORIGINAL:
                    entry["reopen_instruction"] = f"read {pin}"
                else:
                    entry["excerpt"] = "the bytes"
                store.put_evidence(arec.EvidenceEntry(**entry))
            return scope, store

        eng._resolve_web_admission = _seeding_resolver
        try:
            return eng.factcheck_run(
                self.state_dir, str(self.report), "research", self.SID,
                debounce_seconds=0,
                _checker_fn=lambda *_a, **_k: "VERDICT: PASS",
                _proj_topic_resolver=self.resolver,
                max_rounds=3,
                cycle_id="default",
            )
        finally:
            eng._resolve_web_admission = real

    def _grading_marker(self):
        """The marker THIS gate wrote, distinguished from a sibling axis's."""
        for p in _markers(self._topic_dir()):
            if "claim_grading_axis:" in p.read_text(encoding="utf-8"):
                return p
        return None

class EndToEndResearchRunTests(_E2EBase):
    """Driven through `factcheck_run`, NOT a /double-check invocation.

    The plan's A5 validation gate says "demonstrated on a real research
    fact-check run" precisely because the design's own A25 landing would have
    been demonstrable only on the /double-check path, where it is a no-op for
    this kind.
    """

    # NOTE on what the RUN's overall status can and cannot show here. This
    # fixture has no coverage-angles sidecar, so `_run_coverage_axis_gate`
    # independently degrades every run to INCOMPLETE ("no obtainable
    # checklist"), and it runs BEFORE this gate. So in an unmodified run the
    # overall status is NOT the discriminator — `claim_grading_axis` and this
    # gate's own marker are.
    #
    # An earlier version of `test_a_real_run_records_a_withheld_confirmation…`
    # nonetheless asserted `status != "PASS"` and labelled it "(C9)". That
    # assertion was VACUOUS: the coverage axis had already made it true before
    # the grading gate ran, so it held whether this gate worked, was disabled or
    # was broken. It was caught by a checker asked to hunt for exactly that, and
    # it is recorded here rather than quietly deleted, because writing the
    # caveat and then asserting against it anyway is the failure mode the
    # caveat existed to prevent.
    #
    # C9 ("the run's own verdict reflects a withheld confirmation") is now
    # demonstrated by `WithheldConfirmationMovesTheRunVerdictTests` below, which
    # neutralises the confounding axis and asserts a PAIR — the same fixture
    # ending PASS on strong grounds and INCOMPLETE on weakest ones. One arm
    # alone could still be vacuous; the pair cannot.

    def test_a_real_run_records_a_withheld_confirmation_on_the_grading_axis(self):
        self.report.write_text(
            f"# Findings\n\nThe module is broken. [stated — {WEAKEST_PIN}]\n",
            encoding="utf-8")

        verdict = self._run(seed=[(WEAKEST_PIN, srec.SCOPE_MODE_UNSCOPED,
                                   arec.EVIDENCE_CAPTURED)])

        self.assertEqual(verdict["claim_grading_axis"], "INCOMPLETE",
                         "the grading gate withheld the claim's confirmation")
        self.assertIn(WEAKEST_PIN, verdict.get("reason", ""))
        marker = self._grading_marker()
        self.assertIsNotNone(marker, "the run wrote this gate's own marker")
        self.assertIn(WEAKEST_PIN, marker.read_text(encoding="utf-8"))
        self.assertTrue(list(self._topic_dir().glob("*_GRADING_*.md")),
                        "the run left its per-claim record")

    def test_a_real_run_on_strong_grounds_does_not_withhold_and_still_records(self):
        self.report.write_text(
            f"# Findings\n\nThe module opens with one. [stated — {STRONG_PIN}]\n",
            encoding="utf-8")

        verdict = self._run(seed=[(STRONG_PIN, srec.SCOPE_MODE_ENUMERATED,
                                   arec.EVIDENCE_ORIGINAL)])

        self.assertEqual(verdict["claim_grading_axis"], "OK",
                         "strong grounds are confirmed exactly as before (C2)")
        self.assertIsNone(self._grading_marker(),
                          "a clean grading axis writes no marker of its own")
        self.assertTrue(list(self._topic_dir().glob("*_GRADING_*.md")),
                        "an all-strong run still records what it graded")

    def test_a_real_pure_web_run_is_untouched_by_this_gate(self):
        self.report.write_text(
            "# Findings\n\nA claim. [stated — https://example.com/a]\n",
            encoding="utf-8")

        verdict = self._run()

        self.assertNotIn("claim_grading_axis", verdict)
        self.assertIsNone(self._grading_marker())
        self.assertEqual(list(self._topic_dir().glob("*_GRADING_*.md")), [])

    def test_the_gate_still_runs_when_the_admission_context_could_not_be_built(self):
        """The pre-binding this slice added to `factcheck_run`.

        `_resolve_web_admission` raising used to leave `_adm_store` unbound, so
        the gate would have died on a NameError — the same failure mode the
        `cited_urls` pre-binding was added to fix for the zero-coverage gate.
        """
        self.report.write_text(
            f"# Findings\n\nA claim. [stated — {WEAKEST_PIN}]\n", encoding="utf-8")
        original = eng._resolve_web_admission
        try:
            eng._resolve_web_admission = lambda *_a, **_k: (_ for _ in ()).throw(
                RuntimeError("no admission context"))
            verdict = self._run()
        finally:
            eng._resolve_web_admission = original

        # It ran (no NameError, no gate-error INCOMPLETE) and, finding no
        # reachable grounds, recorded them as ungraded WITHOUT withholding —
        # absence of grounds is not the floor (C2).
        self.assertEqual(verdict["claim_grading_axis"], "OK")
        self.assertIn("claim_grading_dispositions", verdict)
        dispositions = verdict["claim_grading_dispositions"]
        self.assertEqual(len(dispositions), 1)
        self.assertEqual(dispositions[0]["status"], "INCOMPLETE")
        self.assertIsNone(self._grading_marker())


class WithheldConfirmationMovesTheRunVerdictTests(_E2EBase):
    """C9, demonstrated as a PAIR with the confounding axis neutralised.

    The content-coverage axis degrades this fixture to INCOMPLETE on its own and
    runs first, so on an unmodified run no assertion about `status` can tell
    whether THIS gate did anything. Neutralising that one sibling — and nothing
    else — is what makes the question answerable.

    Isolating a confound is only worth something if the isolated variable is
    then actually varied, so both arms run the SAME fixture and differ in one
    thing: how the cited claim's grounds were recorded. Strong grounds must end
    PASS; weakest-on-all-three must end INCOMPLETE. Either arm alone could still
    be vacuous — the first if something else forced PASS, the second if
    something else forced INCOMPLETE. The pair cannot be.
    """

    def _run_without_the_coverage_axis(self, seed):
        original = eng._run_coverage_axis_gate
        try:
            # Pass-through: the coverage axis evaluates nothing and mutates
            # nothing. Every other gate in the chain, including this slice's,
            # runs exactly as it does in production.
            eng._run_coverage_axis_gate = (
                lambda _report, _content, verdict, *_a, **_k: verdict)
            return self._run(seed=seed)
        finally:
            eng._run_coverage_axis_gate = original

    def test_strong_grounds_end_the_run_at_pass(self):
        self.report.write_text(
            f"# Findings\n\nThe module opens with one. [stated — {STRONG_PIN}]\n",
            encoding="utf-8")

        verdict = self._run_without_the_coverage_axis(
            seed=[(STRONG_PIN, srec.SCOPE_MODE_ENUMERATED,
                   arec.EVIDENCE_ORIGINAL)])

        self.assertEqual(verdict["status"], "PASS",
                         "with coverage neutralised, a sound run passes (C2)")
        self.assertEqual(verdict["claim_grading_axis"], "OK")

    def test_weakest_on_all_three_moves_the_same_run_to_incomplete(self):
        self.report.write_text(
            f"# Findings\n\nThe module is broken. [stated — {WEAKEST_PIN}]\n",
            encoding="utf-8")

        verdict = self._run_without_the_coverage_axis(
            seed=[(WEAKEST_PIN, srec.SCOPE_MODE_UNSCOPED,
                   arec.EVIDENCE_CAPTURED)])

        self.assertEqual(verdict["status"], "INCOMPLETE",
                         "the withheld confirmation moved the RUN's verdict (C9)")
        self.assertEqual(verdict["claim_grading_axis"], "INCOMPLETE")
        self.assertIn(WEAKEST_PIN, verdict.get("reason", ""))
        self.assertIsNotNone(self._grading_marker())

    def test_unreachable_grounds_leave_the_same_run_at_pass(self):
        """The third arm, and the one that pins the design judgment.

        Same fixture, same neutralisation, nothing seeded — so the claim
        resolves `ungraded`. If absence of grounds were treated as a floor hit,
        this would read INCOMPLETE like the arm above. It reads PASS, which is
        C2 holding for a research file written before any of this existed.
        """
        self.report.write_text(
            f"# Findings\n\nA claim. [stated — {WEAKEST_PIN}]\n", encoding="utf-8")

        verdict = self._run_without_the_coverage_axis(seed=[])

        self.assertEqual(verdict["status"], "PASS")
        self.assertEqual(verdict["claim_grading_axis"], "OK")
        self.assertEqual(
            verdict["claim_grading_dispositions"][0]["status"], "INCOMPLETE",
            "recorded as not confirmed per claim, without withholding the run")


# ---------------------------------------------------------------------------
# A5 — the guard rail: DC_AXIS_REGISTRY is NOT where this landed
# ---------------------------------------------------------------------------
class RegistryUntouchedTests(unittest.TestCase):
    def test_no_grading_axis_was_added_to_the_dc_axis_registry(self):
        """A25 says extend it. The plan says do not, because every consumer of
        that registry sits on the /double-check path — so the edit would be a
        no-op for research AND a live change to /double-check's floor and its
        --auto defaults, whose sole whitelisted caller is /assess."""
        every_axis = {ax["name"]
                      for spec in eng.DC_AXIS_REGISTRY.values()
                      for ax in spec["axes"]}
        for forbidden in ("claim-grading", "internal_claim_grounds", "authority",
                          "currency", "traceability"):
            self.assertNotIn(forbidden, every_axis)
        # The axis universe is locked at three (double-check-allocation.md).
        self.assertEqual(every_axis,
                         {"groundedness", "coverage", "source-quality"})

    def test_the_registry_does_carry_a_research_type_and_it_is_untouched(self):
        """Recorded because an earlier draft of this test asserted the opposite.

        `research` IS a registered /double-check artifact type — the reason A25's
        landing is a no-op is NOT that the type is absent. It is that the research
        FC path never reaches the audit gate: `KIND_PROMPT_TEMPLATES["research"]`
        names no axis, and the research CLI never passes `write_dc_audit`, whose
        default is False. Asserting absence would have been asserting something
        false and would have hidden the real reason.
        """
        self.assertIn("research", eng.DC_AXIS_REGISTRY)
        self.assertEqual(
            [ax["name"] for ax in eng.DC_AXIS_REGISTRY["research"]["axes"]],
            ["groundedness", "coverage", "source-quality"])

    def test_the_audit_gate_is_what_never_fires_for_a_research_run(self):
        """The actual mechanism, pinned so the no-op claim rests on code."""
        import inspect
        src = inspect.getsource(eng.factcheck_run)
        self.assertIn("if write_dc_audit and kind in DC_AXIS_REGISTRY", src)
        sig = inspect.signature(eng.factcheck_run)
        self.assertIs(sig.parameters["write_dc_audit"].default, False)

    def test_the_recommendation_auto_defaults_are_unchanged(self):
        """The stated gate for the case where the mirror pair was touched. It was
        not touched — asserted rather than assumed.

        `_dc_auto_fill_axes` takes the `--auto` PAYLOAD, not a type name; an
        earlier draft passed the bare string and got a schema error back, which
        would have passed as 'unchanged' against an equally wrong expectation.
        """
        out = eng._dc_auto_fill_axes({"artifact_type": "recommendation"})
        self.assertTrue(out["ok"], out)
        self.assertEqual(
            out["axes"],
            [ax["name"] for ax in eng.DC_AXIS_REGISTRY["recommendation"]["axes"]])
        self.assertIn("groundedness", out["axes"])

    def test_the_allocation_drift_guard_still_exits_zero(self):
        guard = HOOKS_DIR / "check-double-check-allocation.sh"
        if not guard.exists():                       # pragma: no cover
            self.skipTest("allocation drift guard not present in this tree")
        proc = subprocess.run(["bash", str(guard)], capture_output=True, text=True,
                              env={**os.environ, "CLAUDE_CONFIG_DIR": str(CONFIG_DIR)})
        self.assertEqual(proc.returncode, 0,
                         f"drift guard failed:\n{proc.stdout}\n{proc.stderr}")


# ---------------------------------------------------------------------------
# A5 — the correction is RECORDED, not merely acted on
# ---------------------------------------------------------------------------
class A25CorrectionRecordedTests(unittest.TestCase):
    DESIGN = (Path(__file__).resolve().parents[3] / "repos" / "Projects" /
              "Thoughts" / "research-source-adapters-20260808213101_DESIGN.md")

    def test_the_a25_row_records_that_its_landing_was_a_no_op(self):
        """"Where a design premise is false, correct it here and say so rather
        than implementing something that satisfies the words and delivers
        nothing." A correction nobody can find is not a correction."""
        if not self.DESIGN.exists():                 # pragma: no cover
            self.skipTest(f"design file not reachable at {self.DESIGN}")
        text = self.DESIGN.read_text(encoding="utf-8")

        # The ROW itself must flag it, so a reader scanning the decisions table
        # cannot act on A25 without meeting the correction.
        row = next((ln for ln in text.splitlines() if ln.startswith("| A25 ")), None)
        self.assertIsNotNone(row, "no A25 row in the decisions table")
        self.assertIn("CORRECTED AT S10", row)
        self.assertIn("NO-OP", row.upper())

        # And the correction itself must say WHY, not merely that.
        self.assertIn("A25 correction", text)
        _, _, note = text.partition("**A25 correction")
        window = note[:4000]
        for required in ("write_dc_audit", "KIND_PROMPT_TEMPLATES",
                         "_run_internal_claim_grading_gate", "/assess"):
            self.assertIn(required, window,
                          f"the correction note does not name {required}")


