WEAKEST_PIN = "code:myrepo@abc123:pkg/other.py:1-400"


def _mock_resolver(proj, topic):
    state = {"topic_slug": proj, "project_slug": topic}
    return lambda _sid: (proj, topic, state)


def _markers(directory):
    """Every VERDICT MARKER in `directory`, by the engine's own predicate.

    Deliberately not a `*R*.md` glob. That was the first version and it was
    wrong in a way worth keeping a note about: it matched the grading RECORD
    (`…_GRADING_fc-1.md` contains an upper-case R), so a test meant to assert
    "a clean run writes no marker" failed on the record it was supposed to
    ignore. Asking the engine's regex is both correct and the same question the
    rollup asks.
    """
    return sorted(p for p in Path(directory).glob("*.md")
                  if eng._KEYED_MARKER_RE.match(p.name)
                  or eng._LEGACY_MARKER_RE.match(p.name))


def _latest_marker_field(directory, field):
    markers = _markers(directory)
    if not markers:
        return None
    for line in markers[-1].read_text(encoding="utf-8").splitlines():
        if line.startswith(f"{field}:"):
            return line.split(":", 1)[1].strip()
    return None


class _GateBase(unittest.TestCase):
    def setUp(self):
        self.tmp = Path(tempfile.mkdtemp())
        self.topic = self.tmp / "topic"
        self.topic.mkdir()
        self.report = self.tmp / "demo-20260101010101_RESEARCH.md"
        self.store = arec.AdmissionRecordStore(self.topic, slug="demo",
                                               ts="20260101010101")

    def tearDown(self):
        shutil.rmtree(self.tmp, ignore_errors=True)

    def _seed(self, pin, *, bound, evidence):
        """Put one evidence entry in the admission record, as the port would."""
        kwargs = {"run_id": "seed", "pin_str": pin, "evidence_path": evidence,
                  "declaration_bound": bound}
        if evidence == arec.EVIDENCE_ORIGINAL:
            kwargs["reopen_instruction"] = f"read {pin}"
        else:
            kwargs["excerpt"] = "the bytes this claim rests on"
        self.store.put_evidence(arec.EvidenceEntry(**kwargs))

    def _write_report(self, *pins):
        body = ["# Findings", ""]
        for i, pin in enumerate(pins, start=1):
            body.append(f"Finding {i}. [stated — {pin}]")
        self.report.write_text("\n".join(body) + "\n", encoding="utf-8")

    def _grading_records(self):
        return sorted(self.topic.glob("*_GRADING_*.md"))


