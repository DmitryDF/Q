class SeverityFoldTests(_GateBase):
    def test_it_does_not_mask_a_more_severe_earlier_axis(self):
        """An earlier ESCALATE outranks this gate's INCOMPLETE, and the marker
        the close gate reads must still resolve to the worse one."""
        self._seed(WEAKEST_PIN, bound=srec.SCOPE_MODE_UNSCOPED,
                   evidence=arec.EVIDENCE_CAPTURED)
        self._write_report(WEAKEST_PIN)
        eng._write_coverage_marker(self.topic, "ESCALATE", [], ["dropped"],
                                   "USER_CONFIRMED", "research")
        verdict = {"status": "ESCALATE", "rounds": 1}

        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store, run_id="fc-1")

        self.assertEqual(out["status"], "ESCALATE", "severity-max, not assignment")
        self.assertEqual(_latest_marker_field(self.topic, "verdict"), "ESCALATE",
                         "a less severe axis must not overwrite a hard block")

    def test_the_always_written_record_does_not_mask_an_earlier_escalate(self):
        """The masking guard at the GATE level, driven by the production path.

        A clean grading run writes its record unconditionally. If that record
        were marker-shaped it would become the newest marker and mask the
        ESCALATE beneath it.
        """
        self._seed(STRONG_PIN, bound=srec.SCOPE_MODE_ENUMERATED,
                   evidence=arec.EVIDENCE_ORIGINAL)
        self._write_report(STRONG_PIN)
        eng._write_coverage_marker(self.topic, "ESCALATE", [], ["dropped"],
                                   "USER_CONFIRMED", "research")
        before = sorted(_markers(self.topic))
        verdict = {"status": "ESCALATE", "rounds": 1}

        eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store, run_id="fc-1")

        self.assertEqual(len(self._grading_records()), 1, "the record was written")
        self.assertEqual(sorted(_markers(self.topic)), before,
                         "and it did not join the marker sequence")
        self.assertEqual(_latest_marker_field(self.topic, "verdict"), "ESCALATE")


