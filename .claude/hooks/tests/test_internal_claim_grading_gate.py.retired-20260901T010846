class GateTruthTableTests(_GateBase):
    def test_a_report_with_no_internal_claim_is_a_no_op(self):
        """A pure-web report must not degrade — and must not pay for the attempt."""
        self.report.write_text("A claim. [stated — https://example.com/a]\n",
                               encoding="utf-8")
        verdict = {"status": "PASS", "rounds": 1}

        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store)

        self.assertEqual(out["status"], "PASS")
        self.assertEqual(list(_markers(self.topic)), [])
        self.assertEqual(self._grading_records(), [],
                         "no internal claim -> no record to write")
        self.assertNotIn("claim_grading_axis", out)

    def test_all_strong_claims_stay_pass_write_no_marker_but_do_leave_a_record(self):
        """The divergence that matters: a clean run still records its judgment."""
        self._seed(STRONG_PIN, bound=srec.SCOPE_MODE_ENUMERATED,
                   evidence=arec.EVIDENCE_ORIGINAL)
        self._write_report(STRONG_PIN)
        verdict = {"status": "PASS", "rounds": 1}

        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store, run_id="fc-1")

        self.assertEqual(out["status"], "PASS")
        self.assertEqual(out["claim_grading_axis"], "OK")
        self.assertEqual(list(_markers(self.topic)), [],
                         "a clean run writes no verdict marker")
        records = self._grading_records()
        self.assertEqual(len(records), 1, "a clean run STILL writes its record")
        doc = cgr.GradingRecordStore(self.topic, slug="demo",
                                     ts="20260101010101").read("fc-1")
        self.assertEqual(doc["folded_status"], "PASS")
        self.assertTrue(doc["grades"][0].rationale.strip())

    def test_weakest_on_all_three_downgrades_and_the_marker_names_the_claim(self):
        self._seed(WEAKEST_PIN, bound=srec.SCOPE_MODE_UNSCOPED,
                   evidence=arec.EVIDENCE_CAPTURED)
        self._write_report(WEAKEST_PIN)
        verdict = {"status": "PASS", "rounds": 1}

        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store, run_id="fc-1")

        self.assertEqual(out["status"], "INCOMPLETE")
        self.assertEqual(_latest_marker_field(self.topic, "verdict"), "INCOMPLETE")
        self.assertEqual(_latest_marker_field(self.topic, "claim_grading_axis"),
                         "internal_claim_grounds")
        marker = sorted(_markers(self.topic))[-1].read_text(encoding="utf-8")
        self.assertIn(WEAKEST_PIN, marker)
        # The ground responsible is NAMED, not merely counted (C8).
        self.assertIn("set no bound", marker)
        self.assertIn("captured snapshot", marker)
        self.assertIn("whole item", marker)
        # Un-accepted: the close gate still blocks.
        self.assertNotIn("accept_reason:", marker)

    def test_the_verdict_carries_the_reason_naming_the_withheld_claim(self):
        self._seed(WEAKEST_PIN, bound=srec.SCOPE_MODE_UNSCOPED,
                   evidence=arec.EVIDENCE_CAPTURED)
        self._write_report(WEAKEST_PIN)
        verdict = {"status": "PASS", "rounds": 1}

        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store, run_id="fc-1")

        self.assertIn(WEAKEST_PIN, out.get("reason", ""))

    def test_one_weakest_claim_among_strong_ones_still_downgrades_the_run(self):
        self._seed(STRONG_PIN, bound=srec.SCOPE_MODE_ENUMERATED,
                   evidence=arec.EVIDENCE_ORIGINAL)
        self._seed(WEAKEST_PIN, bound=srec.SCOPE_MODE_UNSCOPED,
                   evidence=arec.EVIDENCE_CAPTURED)
        self._write_report(STRONG_PIN, WEAKEST_PIN)
        verdict = {"status": "PASS", "rounds": 1}

        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store, run_id="fc-1")

        self.assertEqual(out["status"], "INCOMPLETE")
        doc = cgr.GradingRecordStore(self.topic, slug="demo",
                                     ts="20260101010101").read("fc-1")
        self.assertEqual([g.status for g in doc["grades"]],
                         ["PASS", "INCOMPLETE"])

    def test_a_claim_whose_grounds_cannot_be_reached_does_not_downgrade_the_run(self):
        """C2, and the reason the gate reads the floor rather than the status.

        A research file written before any of this existed cites internal
        sources no admission run ever recorded. Every such claim resolves
        `ungraded`. Treating that as a downgrade would fail every legacy file
        the moment it was re-checked — so absence of grounds is recorded per
        claim and does NOT move the run's verdict. Only ESTABLISHED grounds
        found weakest do.
        """
        self._write_report("code:ghost@000:no/such.py:1-1")   # nothing seeded
        verdict = {"status": "PASS", "rounds": 1}

        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store, run_id="fc-1")

        self.assertEqual(out["status"], "PASS", "a legacy file must not start failing")
        self.assertEqual(list(_markers(self.topic)), [])
        # But it is NOT silently confirmed either — the record says so.
        doc = cgr.GradingRecordStore(self.topic, slug="demo",
                                     ts="20260101010101").read("fc-1")
        self.assertEqual(doc["grades"][0].status, "INCOMPLETE")
        self.assertIn("no admission record", doc["grades"][0].rationale)

    def test_a_genuine_content_non_pass_short_circuits_the_gate(self):
        self._seed(WEAKEST_PIN, bound=srec.SCOPE_MODE_UNSCOPED,
                   evidence=arec.EVIDENCE_CAPTURED)
        self._write_report(WEAKEST_PIN)
        verdict = {"status": "DIRTY", "rounds": 2}

        out = eng._run_internal_claim_grading_gate(
            str(self.report), "DIRTY", verdict, self.topic, "research",
            adm_store=self.store)

        self.assertEqual(out["status"], "DIRTY")
        self.assertEqual(list(_markers(self.topic)), [])
        self.assertEqual(self._grading_records(), [])

    def test_a_non_research_kind_is_untouched(self):
        self._write_report(WEAKEST_PIN)
        verdict = {"status": "PASS", "rounds": 1}
        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "plan",
            adm_store=self.store)
        self.assertEqual(out["status"], "PASS")
        self.assertEqual(self._grading_records(), [])

    def test_a_gate_error_degrades_to_incomplete_never_a_silent_pass(self):
        self._write_report(WEAKEST_PIN)
        verdict = {"status": "PASS", "rounds": 1}

        class _Boom:
            slug = "demo"
            ts = "20260101010101"

            def get_evidence(self, *a, **k):
                raise RuntimeError("record unreadable")

        # A2 is fail-soft, so a raising store yields `ungraded` rather than an
        # exception — which does NOT downgrade. The gate's own last resort is
        # exercised by breaking something A2 cannot absorb.
        original = eng._as_marker_slot
        try:
            eng._as_marker_slot = lambda *_a, **_k: (_ for _ in ()).throw(
                RuntimeError("slot resolution failed"))
            out = eng._run_internal_claim_grading_gate(
                str(self.report), "PASS", verdict, self.topic, "research",
                adm_store=_Boom())
        finally:
            eng._as_marker_slot = original

        self.assertEqual(out["status"], "INCOMPLETE")
        self.assertEqual(out["claim_grading_axis"], "INCOMPLETE")

    def test_losing_the_record_does_not_cost_the_run_its_verdict_signal(self):
        """The record is the audit trail, not the gate."""
        self._seed(WEAKEST_PIN, bound=srec.SCOPE_MODE_UNSCOPED,
                   evidence=arec.EVIDENCE_CAPTURED)
        self._write_report(WEAKEST_PIN)
        verdict = {"status": "PASS", "rounds": 1}

        # A marker-shaped run_id is refused by the record writer (S10/A3).
        out = eng._run_internal_claim_grading_gate(
            str(self.report), "PASS", verdict, self.topic, "research",
            adm_store=self.store, run_id="R1")

        self.assertEqual(out["status"], "INCOMPLETE", "the fold still happened")
        self.assertIn("claim_grading_record_error", out)
        self.assertEqual(self._grading_records(), [])


