def test_a3_an_all_strong_run_still_writes_and_reads_back(tmp_path):
    """The divergence that matters most, and the one a copy of the mirrored
    writer would have missed: the mirror writes ONLY on a downgrade, so a clean
    run would have persisted nothing at all."""
    store = cgr.GradingRecordStore(tmp_path, slug="t", ts="20260101000000")
    grades = [cgr.ClaimGrade(claim_key="code:r@1:a.py:12-14", status="PASS",
                             rationale="confirmed: strong on every ground",
                             grounds={"authority": "strong"})]

    path = store.write("run1", grades)

    assert path.is_file(), "an all-strong run must still leave a record"
    doc = store.read("run1")
    assert doc["folded_status"] == "PASS"
    assert doc["claim_count"] == 1
    assert doc["grades"][0].rationale.startswith("confirmed:")
    assert doc["grades"][0].grounds == {"authority": "strong"}


