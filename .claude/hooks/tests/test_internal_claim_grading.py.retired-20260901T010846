def _load_by_path(name, path):
    """Import a module from an explicit path, bypassing the bare-name cache.

    Same reason as `test_source_admission_port._load_by_path`: other modules in
    this suite import harness modules from the LIVE tree, and the first importer
    wins the bare name. An assertion about the tree under test must not depend
    on collection order.
    """
    import importlib.util
    if name in sys.modules:
        del sys.modules[name]
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def _grounds(*, pin="code:r@abc123:pkg/mod.py:12-14", locator="code",
             status=icg.GROUNDS_RESOLVED, bound=srec.SCOPE_MODE_ENUMERATED,
             evidence=arec.EVIDENCE_ORIGINAL, reason=None, line=1):
    """One resolved ClaimGrounds, built from the real dataclasses."""
    return icg.ClaimGrounds(
        citation=icg.InternalCitation(kind="stated", locator=locator,
                                      pin_str=pin, line=line),
        status=status,
        declaration_bound=bound,
        evidence_path=evidence,
        reason=reason)


# The three "weakest" settings, named once so each axis test says which axis it
# is moving rather than repeating three literals.
_WEAK_AUTHORITY = {"bound": srec.SCOPE_MODE_UNSCOPED}
_WEAK_CURRENCY = {"evidence": arec.EVIDENCE_CAPTURED}
_WEAK_TRACEABILITY = {"pin": "code:r@abc123:pkg/mod.py:1-400"}


