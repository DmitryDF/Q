def test_a4_an_ungraded_claim_is_not_confirmed_and_carries_the_reason():
    """A2 resolves an unreachable citation to `ungraded`. It must not read as
    confirmed — and it is not a floor hit either, since nothing was established."""
    grade = icg_rule.grade_claim(_grounds(
        status=icg.GROUNDS_UNGRADED, bound=None, evidence=None,
        reason="no admission record holds this pin"))

    assert grade.status == icg_rule.STATUS_WITHHELD
    assert "no admission record" in grade.rationale
    assert set(grade.grounds.values()) == {icg_rule.UNKNOWN}


def test_a4_a_report_with_no_internal_claim_grades_nothing():
    """The pure-web edge case: no claims in, no grades out, and the fold of
    nothing is PASS — a web-only report must not degrade."""
    assert icg_rule.grade_all([]) == ()
    assert cgr.fold(icg_rule.grade_all([])) == "PASS"


def test_a4_mints_no_new_verdict_token():
    """The floor degrades through the EXISTING INCOMPLETE. A new token would need
    a reader in every gate that consumes the ladder."""
    import _factcheck_engine as engine

    ladder = set(engine._COVERAGE_SEVERITY_RANK)
    assert icg_rule.STATUS_WITHHELD in ladder
    assert icg_rule.STATUS_CONFIRMS in ladder

    every_shape = [
        _grounds(),
        _grounds(**_WEAK_AUTHORITY),
        _grounds(**_WEAK_AUTHORITY, **_WEAK_CURRENCY),
        _grounds(**_WEAK_AUTHORITY, **_WEAK_CURRENCY, **_WEAK_TRACEABILITY),
        _grounds(status=icg.GROUNDS_UNGRADED, bound=None, evidence=None,
                 reason="none"),
        _grounds(bound=None),
    ]
    statuses = {g.status for g in icg_rule.grade_all(every_shape)}
    assert statuses <= ladder


def test_a4_holds_no_rule_bearing_io():
    """A8's boundary, restated for the rule: it reads and returns, and opens
    nothing. A grader that touched a store could not be reasoned about without
    one."""
    import ast

    tree = ast.parse((HOOKS_DIR / "internal_claim_grader.py").read_text(
        encoding="utf-8"))
    banned = {"open", "write_text", "read_text", "mkdir", "unlink", "replace"}
    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            name = getattr(node.func, "attr", None) or getattr(node.func, "id", None)
            assert name not in banned, (
                f"internal_claim_grader.py calls {name!r} — the rule performs no I/O")


