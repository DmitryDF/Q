def test_a4_weak_on_all_three_withholds_confirmation_and_names_the_grounds():
    grade = icg_rule.grade_claim(_grounds(**_WEAK_AUTHORITY, **_WEAK_CURRENCY,
                                          **_WEAK_TRACEABILITY))

    assert grade.status == icg_rule.STATUS_WITHHELD
    assert grade.grounds == {icg_rule.AXIS_AUTHORITY: icg_rule.WEAK,
                             icg_rule.AXIS_CURRENCY: icg_rule.WEAK,
                             icg_rule.AXIS_TRACEABILITY: icg_rule.WEAK}
    # The reason names the ground responsible, in plain words.
    assert "set no bound" in grade.rationale
    assert "captured snapshot" in grade.rationale
    assert "whole item" in grade.rationale


@pytest.mark.parametrize("weak_axis,kwargs", [
    (icg_rule.AXIS_AUTHORITY, _WEAK_AUTHORITY),
    (icg_rule.AXIS_CURRENCY, _WEAK_CURRENCY),
    (icg_rule.AXIS_TRACEABILITY, _WEAK_TRACEABILITY),
])
def test_a4_weak_on_exactly_one_ground_still_confirms(weak_axis, kwargs):
    grade = icg_rule.grade_claim(_grounds(**kwargs))

    assert grade.status == icg_rule.STATUS_CONFIRMS
    assert grade.grounds[weak_axis] == icg_rule.WEAK
    assert grade.rationale.startswith("confirmed:")


@pytest.mark.parametrize("pair", [
    (_WEAK_AUTHORITY, _WEAK_CURRENCY),
    (_WEAK_AUTHORITY, _WEAK_TRACEABILITY),
    (_WEAK_CURRENCY, _WEAK_TRACEABILITY),
])
def test_a4_weak_on_exactly_two_grounds_still_confirms(pair):
    """The half a wrong implementation gets wrong: the floor is the AND of three,
    not 'two or more'."""
    kwargs = {}
    for part in pair:
        kwargs.update(part)
    grade = icg_rule.grade_claim(_grounds(**kwargs))

    assert grade.status == icg_rule.STATUS_CONFIRMS
    weak = [a for a, v in grade.grounds.items() if v == icg_rule.WEAK]
    assert len(weak) == 2
    assert "not on all three" in grade.rationale


def test_a4_strong_on_everything_confirms():
    grade = icg_rule.grade_claim(_grounds())
    assert grade.status == icg_rule.STATUS_CONFIRMS
    assert set(grade.grounds.values()) == {icg_rule.STRONG}


def test_a4_the_floor_predicate_is_the_single_decision_locus():
    assert icg_rule.floor_withholds({a: icg_rule.WEAK for a in icg_rule.AXES})
    for axis in icg_rule.AXES:
        axes = {a: icg_rule.WEAK for a in icg_rule.AXES}
        axes[axis] = icg_rule.STRONG
        assert not icg_rule.floor_withholds(axes)
        axes[axis] = icg_rule.UNKNOWN
        assert not icg_rule.floor_withholds(axes), (
            "UNKNOWN is not WEAK — a ground nobody recorded must not count "
            "toward the floor")


