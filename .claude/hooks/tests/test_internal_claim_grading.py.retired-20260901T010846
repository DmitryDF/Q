def test_a3_a_grade_without_a_rationale_is_refused_at_construction():
    """The reason is half the grade. A status with no reason asks for the blind
    trust the grading exists to replace."""
    with pytest.raises(cgr.GradingRecordError):
        cgr.ClaimGrade(claim_key="code:r@1:a.py:1-1", status="PASS", rationale="")
    with pytest.raises(cgr.GradingRecordError):
        cgr.ClaimGrade(claim_key="code:r@1:a.py:1-1", status="PASS",
                       rationale="   ")


