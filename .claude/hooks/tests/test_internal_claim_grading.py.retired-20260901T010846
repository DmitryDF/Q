def test_the_grader_and_the_carrier_compose_over_a_mixed_run(tmp_path):
    graded = icg_rule.grade_all([
        _grounds(pin="code:r@abc:a.py:12-14"),
        _grounds(pin="code:r@abc:b.py:1-400", **_WEAK_AUTHORITY,
                 **_WEAK_CURRENCY),
        _grounds(pin="code:r@abc:c.py:1-1", status=icg.GROUNDS_UNGRADED,
                 bound=None, evidence=None, reason="no admission record"),
    ])

    store = cgr.GradingRecordStore(tmp_path, slug="t", ts="20260101000000")
    store.write("fc-1", graded)
    doc = store.read("fc-1")

    assert doc["claim_count"] == 3
    assert doc["folded_status"] == "INCOMPLETE"       # the worst of the three
    assert [g.status for g in doc["grades"]] == ["PASS", "INCOMPLETE",
                                                 "INCOMPLETE"]
    assert all(g.rationale.strip() for g in doc["grades"])
