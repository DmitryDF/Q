def test_a3_the_guard_agrees_with_the_engines_own_marker_regex(tmp_path):
    """The guard states the hazard locally so it still refuses when the engine
    cannot be loaded. This test is what keeps the local statement honest: the
    ENGINE's regex is driven over every name the guard accepts and rejects."""
    import _factcheck_engine as engine

    store = cgr.GradingRecordStore(tmp_path, slug="t", ts="20260101000000")
    for run_id in ("R1", "R12", "R0", "r1", "R", "Ra", "1R", "fc-1", "abc123",
                   "R1x", "x_R2"):
        name = f"t-20260101000000_GRADING_{run_id}.md"
        engine_says_marker = engine._KEYED_MARKER_RE.match(name) is not None
        try:
            store.run_path(run_id)
            guard_refused = False
        except cgr.GradingRecordError:
            guard_refused = True
        assert guard_refused == engine_says_marker, (
            f"run_id {run_id!r}: guard refused={guard_refused} but the engine "
            f"reads {name!r} as a marker={engine_says_marker}")


def test_a3_a_written_record_creates_no_phantom_marker_group(tmp_path):
    """Written into the marker directory itself, the record must not appear in
    the rollup as a file group. This is the harm the guard prevents."""
    import _factcheck_engine as engine

    marker = tmp_path / "t-20260101000000_R1.md"
    marker.write_text("---\nschema_version: 3\nverdict: PASS\nrounds: 1\n---\n",
                      encoding="utf-8")
    cgr.GradingRecordStore(tmp_path, slug="t", ts="20260101000000").write(
        "fc-1", [cgr.ClaimGrade(claim_key="k", status="PASS", rationale="r")])

    rollup = engine.research_rollup(str(tmp_path))
    keys = {row.get("key") for row in rollup["rows"]}
    assert keys == {"t-20260101000000"}, (
        f"the grading record minted a phantom marker group: {keys}")


def test_a3_a_clean_record_leaves_an_earlier_escalate_resolution_unchanged(tmp_path):
    """The masking guard, driven by the PRODUCTION WRITER.

    Hand-placing a file would make this true by construction — the point is that
    the writer this slice ships cannot mask a verdict, not that some file
    somewhere would not.
    """
    import _factcheck_engine as engine

    key = "t-20260101000000"
    escalate = tmp_path / f"{key}_R1.md"
    escalate.write_text(
        "---\nschema_version: 3\nverdict: ESCALATE\nrounds: 1\n---\n",
        encoding="utf-8")

    before = engine._latest_marker(tmp_path, "default", key=key)
    assert engine._parse_marker_frontmatter(before).get("verdict") == "ESCALATE"

    cgr.GradingRecordStore(tmp_path, slug="t", ts="20260101000000").write(
        "fc-1", [cgr.ClaimGrade(claim_key="k", status="PASS",
                                rationale="confirmed: strong on every ground")])

    after = engine._latest_marker(tmp_path, "default", key=key)
    assert after == before
    assert engine._parse_marker_frontmatter(after).get("verdict") == "ESCALATE"


