@pytest.mark.parametrize("statuses,worst", [
    (["PASS", "PASS"], "PASS"),
    (["PASS", "INCOMPLETE"], "INCOMPLETE"),
    (["INCOMPLETE", "ESCALATE"], "ESCALATE"),
    (["ESCALATE", "INCOMPLETE", "PASS"], "ESCALATE"),
    ([], "PASS"),
])
def test_a3_the_folded_status_is_the_worst(statuses, worst):
    grades = [cgr.ClaimGrade(claim_key=f"code:r@1:a.py:{i}-{i}", status=s,
                             rationale="r")
              for i, s in enumerate(statuses, start=1)]
    assert cgr.fold(grades) == worst


def test_a3_a_pre_existing_incomplete_does_not_suppress_a_per_claim_block():
    """Order-independent: the worst wins whichever way round they arrive."""
    incomplete = cgr.ClaimGrade(claim_key="a", status="INCOMPLETE", rationale="r")
    block = cgr.ClaimGrade(claim_key="b", status="ESCALATE", rationale="r")
    assert cgr.fold([incomplete, block]) == "ESCALATE"
    assert cgr.fold([block, incomplete]) == "ESCALATE"


