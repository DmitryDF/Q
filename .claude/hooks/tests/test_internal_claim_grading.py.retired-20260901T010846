def test_a3_one_disposition_per_claim(tmp_path):
    store = cgr.GradingRecordStore(tmp_path, slug="t", ts="20260101000000")
    twice = [
        cgr.ClaimGrade(claim_key="code:r@1:a.py:1-1", status="PASS", rationale="a"),
