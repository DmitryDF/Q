{
  "permissions": {
    "allow": [
      "Bash(gh repo clone:*)",
      "Bash(git clone:*)",
      "Bash(curl:*)",
      "Bash(gh auth:*)",
      "Bash(git fetch:*)",
      "Bash(git remote set-url:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(pip3 install:*)",
      "Bash(pip3 show:*)",
      "Bash(ls:*)",
      "Bash(sqlite3:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(cd * && git *)",
      "Bash(cd * && grep *)",
      "Bash(cd * && rg *)",
      "Bash(cd * && cat *)",
      "Bash(cd * && head *)",
      "Bash(cd * && python*)",
      "Bash(for *)",
      "WebSearch",
      "Bash(xargs cat:*)",
      "Bash(osascript:*)",
      "Bash(find:*)",
      "Bash(pdftotext:*)",
      "Bash(head:*)",
      "Bash(find .:*)",
      "Bash(cd:*)",
      "Bash(brctl download:*)",
      "WebFetch(domain:www.anthropic.com)",
      "Skill(close)",
      "Bash(claude:*)",
      "Bash(test:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(pandoc:*)",
      "Bash(command:*)",
      "Bash(unzip:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "WebFetch(domain:claude.com)",
      "Bash(gh api:*)",
      "Bash(claude plugin:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/log-prompt.sh"
          },
          {
            "type": "command",
            "command": "python3 ${KIT_HOOKS_DIR}/todo.py"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/clarification-nudge.sh"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/refresh-topic-locks.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/guard-config-paths.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/bookkeeping-snapshot.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/fix-backslash-paths.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/sanitize-bash.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-verifier-isolation.sh pre"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/inject-subagent-preamble.sh"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/research-scope-gate.sh"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-skill-marker.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-discovery-lock.sh"
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/research-scope-gate.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/research-scope-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/research-scope-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/research-scope-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/pre-delete-claude-rule.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/log-output.sh"
          },
          {
            "type": "command",
            "command": "python3 ${KIT_HOOKS_DIR}/discovery-present-gate.py"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-research-gate.sh"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-research-pipeline-gate.sh"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-handoff-marker.sh"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-phase-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/bookkeeping-invariant.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-todo-direct-write.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${KIT_HOOKS_DIR}/clarification_anchor.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/track-session-files.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/verify-thought-file.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/factcheck-thought-file.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/factcheck-research-file.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/research-linkcheck.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-verifier-isolation.sh post"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/harvest-on-verify.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/check-citation-check.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/snapshot-git-status.sh"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/cleanup-stale-verifier-isolation.sh"
          },
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/sweep-dead-locks.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/release-session-locks.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${KIT_HOOKS_DIR}/pre-compact-save.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "autoUpdatesChannel": "stable"
}
