# Session logs (created per-session, not tracked)
.claude/logs/
.claude/plans/
.claude/settings.local.json
.claude/session-state/
.claude/state/
.claude/statsig/
.claude/shell-snapshots/

# Diary entries (personal session logs)
Diary/*.md
!Diary/README.md

# Thoughts (personal staging)
Thoughts/*.md
!Thoughts/README.md

# Tool caches — these are generated, and one of them (a pytest cache naming
# internal test ids) shipped once before this line existed.
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc

# OS files
.DS_Store
